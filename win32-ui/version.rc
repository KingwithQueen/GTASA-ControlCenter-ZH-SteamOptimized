#include <windows.h>
#include "version.h"

#ifdef GTASA_STEAM_BACKEND_RESOURCE
#define GTASA_FILE_DESCRIPTION "GTA San Andreas Control Center Steam Backend"
#define GTASA_FILE_NAME "GTASASteam.dll"
#define GTASA_FILE_TYPE VFT_DLL
#else
#define GTASA_FILE_DESCRIPTION "GTA San Andreas Control Center"
#define GTASA_FILE_NAME "GTASAControlCenterUI.exe"
#define GTASA_FILE_TYPE VFT_APP
#endif

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US

1 VERSIONINFO
FILEVERSION GTASA_VERSION_FIXED
PRODUCTVERSION GTASA_VERSION_FIXED
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE GTASA_FILE_TYPE
FILESUBTYPE 0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", GTASA_FILE_DESCRIPTION
            VALUE "FileVersion", GTASA_VERSION_TEXT
            VALUE "OriginalFilename", GTASA_FILE_NAME
            VALUE "ProductName", "GTA San Andreas Control Center"
            VALUE "ProductVersion", GTASA_VERSION_TEXT
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
